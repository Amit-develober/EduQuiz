rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for the "users" collection (Leaderboard)
    match /users/{userId} {
      
      // Anyone can read the users collection (to view the leaderboard)
      allow read: if true;
      
      // Users can only create or update their OWN document
      allow create: if request.auth != null && request.auth.uid == userId;
      
      allow update: if request.auth != null && request.auth.uid == userId
                    // Prevent God-Mode Cheat: Max XP increase per save is 200 XP
                    // This stops console hackers from giving themselves 9,999,999 XP
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['xp'])
                      || (request.resource.data.xp - resource.data.xp) <= 200
                      || request.resource.data.xp <= resource.data.xp // Allow XP loss (penalties)
                    )
                    // Ensure accuracy is a valid percentage
                    && request.resource.data.accuracy >= 0 
                    && request.resource.data.accuracy <= 100;
      allow delete: if false;
    }
    // Rules for "contactMessages" collection (Contact Form submissions)
    match /contactMessages/{messageId} {
      // Anyone can submit a message
      allow create: if true
                    && request.resource.data.keys().hasAll(['name', 'mobile', 'school', 'message', 'dateTime'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 50
                    && request.resource.data.mobile is string
                    && request.resource.data.school is string
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 1000;
      
      // ONLY the authorized Admin UID can read/download messages
      allow read: if request.auth != null && request.auth.uid == 'mA0yscnrpTTAuCUcSMm9fiUgpRD3';
      
      // Nobody can update or delete from the client
      allow update, delete: if false;
    }
  }
}
